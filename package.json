{
  "name": "dsh-repetition-guard",
  "version": "0.2.0",
  "description": "DSH plugin for streaming repetition detection, failed-attempt quarantine, and bounded retries",
  "keywords": ["deepseek-harness", "dsh", "cordis", "reasoning", "loop-guard", "repetition-guard"],
  "author": "dsh-repetition-guard contributors",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./detector": "./lib/detector.js" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22.15" },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "js-yaml": "^4.1.0"
  }
}
